# Copy this file to .env and fill in the values.
#     cp .env.example .env

# --------------------------------------------------------------------------
# Required for the OpenAI-backed LLM layers (country / extract / reconcile).
# --------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --------------------------------------------------------------------------
# Required for the ElevenLabs Scribe v2 transcriber.
# Without this key the Scribe path is unavailable; on a CPU-only host
# this means the pipeline cannot run at all (no fallback transcriber).
# --------------------------------------------------------------------------
ELEVENLABS_API_KEY=xi-...

# --------------------------------------------------------------------------
# Langfuse self-hosted observability.
#
# These are the public/secret keys that the bundled Langfuse container
# will be auto-provisioned with on first start (LANGFUSE_INIT_PROJECT_*).
# The phonebot service uses the same values to send traces, so the whole
# loop is wired up after a single `docker compose up -d`.
#
# Defaults below are fine for local development. ROTATE before any shared
# / production deployment by replacing them with random strings (any
# value works as long as the public key starts with "pk-lf-" and the
# secret key starts with "sk-lf-").
#
# To use Langfuse Cloud instead of the bundled instance, set
# LANGFUSE_HOST=https://cloud.langfuse.com and paste the keys you got
# from the cloud UI here.
# --------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-phonebot-dev-public
LANGFUSE_SECRET_KEY=sk-lf-phonebot-dev-secret
# When the pipeline runs inside the Docker stack, compose overrides this
# to http://langfuse:3000 (service-to-service). The localhost value below
# is only used when phonebot runs directly on the host.
LANGFUSE_HOST=http://localhost:3000

# Login credentials for the Langfuse UI at http://localhost:3000.
# These are seeded into the database on first start.
LANGFUSE_INIT_USER_EMAIL=admin@phonebot.local
LANGFUSE_INIT_USER_PASSWORD=changeme1234

# Random strings (>=32 chars) used by Langfuse for session signing.
# Replace these with `openssl rand -hex 32` output before any shared use.
LANGFUSE_NEXTAUTH_SECRET=please-replace-with-32-plus-character-random-string
LANGFUSE_SALT=please-replace-with-32-plus-character-random-string

# To disable Langfuse entirely, comment out LANGFUSE_PUBLIC_KEY and
# LANGFUSE_SECRET_KEY (or set them to empty). The pipeline runs
# identically without observability.
