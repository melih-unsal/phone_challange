\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Full-record accuracy across configurations. The label encodes the STT set, the audio LLM (\textsf  {AL+}/\textsf  {AL-}), the targeted re-listen (\textsf  {T+}/\textsf  {T-}), and the Whisper timestamper (\textsf  {W+}/\textsf  {W-}). \textsf  {n} is the number of reports aggregated for the cell. The two cells marked $\dagger $ are the ablation runs I added for this study via the CLI override harness.}}{8}{table.caption.7}\protected@file@percent }
\newlabel{tab:headline}{{2}{8}{Full-record accuracy across configurations. The label encodes the STT set, the audio LLM (\textsf {AL+}/\textsf {AL-}), the targeted re-listen (\textsf {T+}/\textsf {T-}), and the Whisper timestamper (\textsf {W+}/\textsf {W-}). \textsf {n} is the number of reports aggregated for the cell. The two cells marked $\dagger $ are the ablation runs I added for this study via the CLI override harness}{table.caption.7}{}}
