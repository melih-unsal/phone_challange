\newlabel{fig:agreement}{{5a}{9}{Inter-candidate agreement on the best run, per field. Phone and email are unanimous on most records; first/last-name disagreements are concentrated on a few diacritic-heavy callers}{figure.caption.11}{}}
\newlabel{sub@fig:agreement}{{a}{9}{Inter-candidate agreement on the best run, per field. Phone and email are unanimous on most records; first/last-name disagreements are concentrated on a few diacritic-heavy callers}{figure.caption.11}{}}
\newlabel{fig:targeted}{{5b}{9}{Layer 4.5 firing modes on the best run. \textsf {cropped} means the layer ran on a Whisper-cropped audio window; \textsf {skipped\_unanimous} means the gate closed because all whole-record candidates agreed}{figure.caption.11}{}}
\newlabel{sub@fig:targeted}{{b}{9}{Layer 4.5 firing modes on the best run. \textsf {cropped} means the layer ran on a Whisper-cropped audio window; \textsf {skipped\_unanimous} means the gate closed because all whole-record candidates agreed}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Disagreement distribution (left) drives Layer 4.5 firing behaviour (right). Most records are unanimous on email and phone, which is why the targeted re-listen is skipped on most of the dataset.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:agreement_and_targeted}{{5}{9}{Disagreement distribution (left) drives Layer 4.5 firing behaviour (right). Most records are unanimous on email and phone, which is why the targeted re-listen is skipped on most of the dataset}{figure.caption.11}{}}
